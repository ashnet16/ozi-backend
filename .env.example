# Copy to .env and fill in. Docker Compose reads .env automatically; .env is git-ignored.
POSTGRES_USER=
POSTGRES_PASSWORD=
OPENAI_API_KEY=

# Optional: host ports, if the defaults (5432 / 6379 / 8000) are taken on your machine.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# API_HOST_PORT=8000

# Optional: gRPC address of the Snapchain node the poller subscribes to.
# The default is the local devnet started with `make snapchain-up`.
# SNAPCHAIN_ENDPOINT=host.docker.internal:3383

# Optional: for a hosted node. TLS is also switched on by an https:// endpoint.
# SNAPCHAIN_USE_TLS=true
# SNAPCHAIN_API_KEY=
# SNAPCHAIN_API_KEY_HEADER=x-api-key
